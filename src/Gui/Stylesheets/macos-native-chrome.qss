/* macOS: let Cocoa draw dock title bars instead of FreeCAD's custom QSS chrome. */
QDockWidget::title {
  background: none;
  padding: 0px;
  spacing: 0px;
  border-style: none;
  font-weight: normal;
}

QDockWidget::close-button,
QDockWidget::float-button {
  image: none;
  border: none;
  background: transparent;
}

QDockWidget {
  border-right: 1px solid @GeneralBorderColor;
}

QMainWindow::separator {
  width: 6px;
  height: 6px;
  background: @GeneralBorderColor;
}

QWidget#Model,
QWidget#ComboView {
  border-right: 2px solid @GeneralBorderColor;
}

QWidget#OverlayEdgeGrip {
  background-color: @GeneralBorderColor;
}

QWidget#RollbackBar {
  background: none;
  border-top: 1px solid @GeneralBorderColor;
}
